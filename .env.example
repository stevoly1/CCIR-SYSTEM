# Copy this file to .env and fill in real values before running the app.
# Nothing in this file is a real secret — it only documents what's required.

# ── Server ──────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ── Database ────────────────────────────────────────────
# Any MongoDB instance — local, self-hosted, or a managed service.
MONGO_URL=mongodb://localhost:27017/ccir-system

# ── Browser security / Frontend origin ─────────────────
# Exactly one browser origin. Production must use HTTPS. This is the only
# credentialed CORS origin and the required Origin for state-changing requests.
BROWSER_ORIGIN=http://localhost:3000
# Number of reverse-proxy hops trusted for forwarded client/protocol headers.
TRUST_PROXY_HOPS=0
# Used only to build links inside notification emails.
ALLOWED_ORIGIN=http://localhost:5173

# ── Cookies & Auth ──────────────────────────────────────
# Long random strings — generate your own, do not reuse these examples.
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
COOKIE=change-this-to-a-long-random-string
JWT_TOKEN=change-this-to-a-long-random-string
JWT_REFRESH_TOKEN=change-this-to-a-different-long-random-string
# Short duration strings: <number><unit>, unit is one of s / m / h / d
ACCESS_TOKEN_LIFESPAN=15m
REFRESH_TOKEN_LIFESPAN=30d
# Dedicated HMAC key for authentication throttle counter identifiers.
AUTH_THROTTLE_HMAC_SECRET=change-this-to-another-long-random-string

# ── Google Sign-In (optional) ────────────────────────────
# Leave blank to disable "Sign in with Google" — email/password signup and
# login still work without these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback

# ── AI complaint classification (Google Gemini) ─────────
# Required for automatic classification/priority/summary/tags. Without it,
# complaints are still accepted; they just fall back to a default category
# and priority instead of an AI-assigned one. Get a key from Google AI Studio.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_TIMEOUT_MS=8000

# Location lookups (Photon): request timeout in milliseconds, 1000-10000 (default 4000).
# Complaint submission never waits on the geocoder; this bounds /location/* only.
LOCATION_TIMEOUT_MS=4000

# ── Photo storage (Cloudinary) ───────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email notifications (Resend, optional) ──────────────
# Without RESEND_API_KEY, the app still works; email notifications are just
# skipped rather than failing the request.
RESEND_API_KEY=
EMAIL_FROM=CCIR System <notifications@yourdomain.com>

# Interactive API documentation at /api/v1/docs (the JSON contract at /api/v1/openapi.json is always on).
API_DOCS_UI=true
