# Copy this file to .env and fill in real values before running the app.
# Nothing in this file is a real secret — it only documents what's required.

# ── Server ──────────────────────────────────────────────
PORT=8080
NODE_ENV=development
# Log detail: fatal, error, warn, info (default), debug (adds health-probe requests), trace, silent.
# Logs are JSON lines on stdout; secrets, cookies and personal data are never written.
LOG_LEVEL=info
# How long /api/v1/health/ready reuses its database check, in milliseconds (0 = check every call).
READINESS_CACHE_MS=1000

# ── Database ────────────────────────────────────────────
# MongoDB 4.4 or later, running as a replica set (transactions need it). Hosted clusters
# (for example mongodb+srv://… on Atlas) already are. A self-managed server, even a single
# one, must be started with --replSet and initiated once with rs.initiate().
# In production, build indexes before the first start: npm run db:indexes -- --apply
MONGO_URL=mongodb://localhost:27017/ccir-system?replicaSet=rs0

# ── Background work (emails) ────────────────────────────
# Redis for the job queue. Upstash and other hosted Redis use rediss:// (TLS). Needed where the
# worker runs: `npm run worker`, or this API with WORKERS_IN_PROCESS=true. Turn eviction off
# (maxmemory-policy noeviction): the queue loses jobs otherwise.
REDIS_URL=
# true runs the workers inside this API process (for single-service hosting).
WORKERS_IN_PROCESS=false
# How often the relay moves saved jobs into Redis, in milliseconds (250 to 60000).
RELAY_INTERVAL_MS=1000

# ── Browser security / Frontend origin ─────────────────
# Exactly one browser origin. Production must use HTTPS. This is the only
# credentialed CORS origin and the required Origin for state-changing requests.
BROWSER_ORIGIN=http://localhost:3000
# Number of reverse-proxy hops trusted for forwarded client/protocol headers.
TRUST_PROXY_HOPS=0
# Used only to build links inside notification emails; normally the same as BROWSER_ORIGIN.
ALLOWED_ORIGIN=http://localhost:3000

# ── Cookies & Auth ──────────────────────────────────────
# Long random strings — generate your own, do not reuse these examples.
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
COOKIE=change-this-to-a-long-random-string
JWT_TOKEN=change-this-to-a-long-random-string
JWT_REFRESH_TOKEN=change-this-to-a-different-long-random-string
# Short duration strings: <number><unit>, unit is one of s / m / h / d
ACCESS_TOKEN_LIFESPAN=15m
REFRESH_TOKEN_LIFESPAN=30d
# Dedicated HMAC key for authentication throttle counter identifiers.
AUTH_THROTTLE_HMAC_SECRET=change-this-to-another-long-random-string

# ── Google Sign-In (optional) ────────────────────────────
# Leave blank to disable "Sign in with Google" — email/password signup and
# login still work without these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback

# ── AI complaint classification (Google Gemini) ─────────
# Required for automatic classification/priority/summary/tags. Without it,
# complaints are still accepted; they just fall back to a default category
# and priority instead of an AI-assigned one. Get a key from Google AI Studio.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_TIMEOUT_MS=8000

# Location lookups (Photon): request timeout in milliseconds, 1000-10000 (default 4000).
# Complaint submission never waits on the geocoder; this bounds /location/* only.
LOCATION_TIMEOUT_MS=4000

# ── Photo storage (Cloudinary) ───────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email notifications (Resend, optional) ──────────────
# Sent by the background worker. Without RESEND_API_KEY, emails fail and show on the
# administrator's Jobs page; everything else works.
RESEND_API_KEY=
EMAIL_FROM=CCIR System <notifications@yourdomain.com>

# ── API documentation ───────────────────────────────────
# Interactive documentation at /api/v1/docs; set to false to turn it off.
# The JSON contract at /api/v1/openapi.json is always available.
API_DOCS_UI=true
