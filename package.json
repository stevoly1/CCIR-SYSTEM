{
    "name": "CCIR System",
    "version": "1.0.0",
    "description": "Open-source, self-hostable backend for AI-assisted citizen complaint and infrastructure reporting.",
    "main": "app.js",
    "scripts": {
        "check:runtime": "node scripts/checkRuntime.js",
        "check:tracked-files": "node scripts/ci/trackedFiles.js",
        "preinstall": "node scripts/checkRuntime.js",
        "start": "node server.js",
        "dev": "nodemon server.js",
        "set-role": "node scripts/setUserRole.js",
        "migrate:phase1": "node scripts/migratePhase1.js",
        "migrate:phase2": "node scripts/migratePhase2.js",
        "pretest": "node scripts/checkRuntime.js",
        "test": "npm run test:unit && npm run test:integration",
        "pretest:unit": "node scripts/checkRuntime.js",
        "test:unit": "vitest run --config vitest.unit.config.mjs",
        "pretest:integration": "node scripts/checkRuntime.js",
        "test:integration": "OPENAPI_COVERAGE=enforce vitest run --config vitest.integration.config.mjs",
        "pretest:coverage": "node scripts/checkRuntime.js",
        "test:coverage": "vitest run --config vitest.coverage.config.mjs --coverage",
        "db:indexes": "node scripts/db/indexes.js",
        "db:backup": "node scripts/db/backup.js",
        "db:restore": "node scripts/db/restore.js",
        "db:rehearse": "node scripts/db/rehearse.js"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "type": "commonjs",
    "packageManager": "npm@12.1.0",
    "engines": {
        "node": ">=26.9.0 <27",
        "npm": ">=12.1.0 <13"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "busboy": "^1.6.0",
        "cloudinary": "^2.11.0",
        "compression": "^1.8.2",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^18.0.3",
        "express": "^5.2.1",
        "express-rate-limit": "^8.7.0",
        "helmet": "^8.3.0",
        "http-status-codes": "^2.3.0",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.10.2",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "resend": "^6.28.1",
        "sharp": "0.35.4",
        "swagger-ui-dist": "^5.33.0",
        "yaml": "^2.9.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@apidevtools/swagger-parser": "^13.1.0",
        "@vitest/coverage-v8": "^5.0.1",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "express-openapi-validator": "^5.6.2",
        "mongodb-memory-server": "^11.3.0",
        "nodemon": "^3.1.14",
        "supertest": "^7.3.0",
        "vite": "^8.3.0",
        "vitest": "^5.0.1"
    },
    "allowScripts": {
        "fsevents": false,
        "mongodb-memory-server": false,
        "@scarf/scarf": false
    }
}
