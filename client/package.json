{
    "name": "vite-project",
    "private": true,
    "license": "MIT",
    "version": "0.0.0",
    "type": "module",
    "packageManager": "npm@12.1.0",
    "engines": {
        "node": ">=26.9.0 <27",
        "npm": ">=12.1.0 <13"
    },
    "scripts": {
        "check:runtime": "node ../scripts/checkRuntime.js",
        "preinstall": "node ../scripts/checkRuntime.js",
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "pretest": "node ../scripts/checkRuntime.js",
        "test": "npm run test:unit && npm run test:e2e",
        "pretest:unit": "node ../scripts/checkRuntime.js",
        "test:unit": "vitest run --config vitest.config.js",
        "pretest:e2e": "node ../scripts/checkRuntime.js",
        "test:e2e": "node scripts/e2e.mjs"
    },
    "dependencies": {
        "@reduxjs/toolkit": "^2.12.0",
        "axios": "^1.20.0",
        "lucide-react": "^1.48.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-hot-toast": "^2.6.1",
        "react-redux": "^9.3.0",
        "react-router": "^8.4.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10.11.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.12.0",
        "jsdom": "^30.1.1",
        "vite": "^8.3.0",
        "vitest": "^5.0.1"
    },
    "allowScripts": {
        "fsevents": false
    }
}
